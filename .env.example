# --- PsycInfo through the EBSCOhost website (backend: ebscohost) ---
# Any address from your EBSCO search session; only the part up to /c/<id> is used.
EBSCOHOST_URL=https://research.ebsco.com/c/abc123/search
# EBSCOHOST_DB=psyh              # database short name; psyh is APA PsycInfo
# EBSCOHOST_DELAY=5              # seconds between searches (minimum 3)
# EBSCOHOST_MAX_SEARCHES=120     # searches allowed per run
# --- PsycInfo through the EBSCO API (backend: ebsco); credentials come from your library ---
# EBSCO_PROFILE=
# EBSCO_USER_ID=
# EBSCO_PASSWORD=
# EBSCO_AUTH=ip                  # instead of user id and password, on a registered campus IP
# EBSCO_DB=psyh

# --- Optional: a free OpenAlex key raises its daily allowance ---
# OPENALEX_API_KEY=
